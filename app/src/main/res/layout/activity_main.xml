<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_background"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/button_tab_home"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Home"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color_selector"
                android:textSize="11sp"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="8dp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/button_tab_collections"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Collections"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color_selector"
                android:textSize="11sp"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="8dp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/button_tab_profile"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Profile"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color_selector"
                android:textSize="11sp"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="8dp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/button_tab_logout"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/accent_action"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
